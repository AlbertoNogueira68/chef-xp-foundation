# Produção. Copiar para .env.prod na máquina e preencher.
# O .env.prod NUNCA vai para o git (o .gitignore já apanha .env.*).
#
# Correr com:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
#
# O --env-file é preciso porque há variáveis que o próprio compose lê
# (SITE_DOMAIN, ACME_EMAIL, POSTGRES_*), e não só o contentor.

# --- Onde a aplicação vive -------------------------------------------
# O nome que aponta para esta máquina. Com o deSEC é algo como
# chef-xp.dedyn.io. É este nome que o Caddy usa para pedir o certificado,
# portanto tem de resolver para o IP desta máquina ANTES do primeiro arranque.
SITE_DOMAIN=
# Para onde o Let's Encrypt avisa se uma renovação falhar. Um email a sério.
ACME_EMAIL=

# --- Base de dados ----------------------------------------------------
POSTGRES_USER=chef
POSTGRES_PASSWORD=
POSTGRES_DB=chef_xp
DATABASE_URL=postgresql://chef:AQUI_A_MESMA_PASSWORD@postgres:5432/chef_xp

# --- Aplicação --------------------------------------------------------
NODE_ENV=production
PORT=3010
# Gerar um novo, nunca reutilizar o de desenvolvimento:
#   openssl rand -hex 32
JWT_SECRET=
# Os dois com https e sem barra no fim.
FRONTEND_URL=https://SUBSTITUIR.dedyn.io
CORS_ORIGIN=https://SUBSTITUIR.dedyn.io

# --- Início de sessão com a Google ------------------------------------
# A mesma credencial do desenvolvimento serve. Acrescenta na consola da Google
# o URI de redirecionamento:
#   https://SUBSTITUIR.dedyn.io/api/auth/google/callback
# E publica o ecrã de consentimento, senão só entram os utilizadores de teste.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Envio de email ---------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# O "De:" dos emails. Com o Gmail, o endereço tem de ser o do SMTP_USER.
# Deixar vazio usa o SMTP_USER tal como está.
MAIL_FROM=Chef XP <SUBSTITUIR@gmail.com>
