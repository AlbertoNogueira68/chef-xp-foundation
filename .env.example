DATABASE_URL=postgresql://chef:chefdev@localhost:5432/chef_xp
POSTGRES_USER=chef
POSTGRES_PASSWORD=chefdev
POSTGRES_DB=chef_xp
PORT=3010
NODE_ENV=development
JWT_SECRET=dev-only-insecure-jwt-secret-min-32-chars
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
VITE_API_URL=/api
VITE_APP_ENV=development

# Cookies: por omissao seguem o NODE_ENV.
# Poe "false" so se precisares de demonstrar uma build de producao em http.
# COOKIE_SECURE=true

# Onde ficam as imagens carregadas (por omissao ./uploads)
# UPLOAD_DIR=/app/uploads

# --- Início de sessão com a Google (opcional) -------------------------
# Sem estas duas, o SSO fica desligado e o botão não aparece na app.
#
# Onde obter: console.cloud.google.com -> APIs e Serviços -> Credenciais
# -> Criar credenciais -> ID de cliente OAuth -> Aplicação Web.
#
# Em "URIs de redirecionamento autorizados" tem de constar EXATAMENTE:
#   http://localhost:5173/api/auth/google/callback     (desenvolvimento)
#   https://o-teu-dominio/api/auth/google/callback     (produção)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
#
# Por omissão o URI de retorno é FRONTEND_URL + /api/auth/google/callback.
# Só define isto se precisares de outro:
# GOOGLE_REDIRECT_URI=

# --- Email (SMTP) -----------------------------------------------------
# Necessário para confirmar a conta e para recuperar a password.
#
# TRÊS MANEIRAS DE TRABALHAR NISTO:
#
# 1. Sem nada configurado. O código aparece na CONSOLA do servidor e a app
#    funciona à mesma. Chega para a maior parte do trabalho.
#
# 2. Com o Mailpit, uma caixa de correio local que apanha tudo e mostra os
#    emails como eles chegam mesmo — assunto, remetente, o código. Nada sai da
#    máquina e nenhum teste aterra na caixa de correio de uma pessoa a sério.
#
#      docker compose -f docker-compose.dev.yml up mailpit
#
#    A correr a app dentro do Docker não é preciso fazer mais nada: já é o
#    destino por omissão. A correr fora (npm run dev:all), descomenta:
#      SMTP_HOST=localhost
#      SMTP_PORT=1025
#    Os emails abrem-se em http://localhost:8025
#
# 3. Com um servidor a sério, para provar que as credenciais servem. O que
#    estiver aqui definido ganha sempre ao Mailpit.
#
# Testa com:  npm run mail:check -- tu@exemplo.pt
#
# SMTP_USER e SMTP_PASSWORD andam aos pares — uma sem a outra não arranca. As
# duas juntas são opcionais: há servidores que não pedem autenticação nenhuma,
# e o Mailpit é um deles.
#
# Em produção o SMTP_HOST é obrigatório: uma conta que se cria e nunca se
# consegue confirmar, sem explicação nenhuma, é pior do que um servidor que
# não sobe.
# SMTP_HOST=smtp.o-teu-fornecedor.pt
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
#
# Porta 587 usa STARTTLS e 465 usa TLS desde o início; o servidor escolhe
# sozinho a partir do número, que é o erro de configuração mais comum.
#
# Remetente. Por omissão usa o SMTP_USER.
# SMTP_FROM=ChefXP <nao-responder@o-teu-dominio.pt>
