DATABASE_URL=postgresql://chef:chefdev@localhost:5432/chef_xp
POSTGRES_USER=chef
POSTGRES_PASSWORD=chefdev
POSTGRES_DB=chef_xp
PORT=3010
NODE_ENV=development
JWT_SECRET=dev-only-insecure-jwt-secret-min-32-chars
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
VITE_API_URL=/api
VITE_APP_ENV=development

# Cookies: por omissao seguem o NODE_ENV.
# Poe "false" so se precisares de demonstrar uma build de producao em http.
# COOKIE_SECURE=true

# Onde ficam as imagens carregadas (por omissao ./uploads)
# UPLOAD_DIR=/app/uploads

# --- Início de sessão com a Google (opcional) -------------------------
# Sem estas duas, o SSO fica desligado e o botão não aparece na app.
#
# Onde obter: console.cloud.google.com -> APIs e Serviços -> Credenciais
# -> Criar credenciais -> ID de cliente OAuth -> Aplicação Web.
#
# Em "URIs de redirecionamento autorizados" tem de constar EXATAMENTE:
#   http://localhost:5173/api/auth/google/callback     (desenvolvimento)
#   https://o-teu-dominio/api/auth/google/callback     (produção)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
#
# Por omissão o URI de retorno é FRONTEND_URL + /api/auth/google/callback.
# Só define isto se precisares de outro:
# GOOGLE_REDIRECT_URI=
