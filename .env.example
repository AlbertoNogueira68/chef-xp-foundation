DATABASE_URL=postgresql://chef:chefdev@localhost:5432/chef_xp
POSTGRES_USER=chef
POSTGRES_PASSWORD=chefdev
POSTGRES_DB=chef_xp
PORT=3010
NODE_ENV=development
JWT_SECRET=dev-only-insecure-jwt-secret-min-32-chars
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
VITE_API_URL=/api
VITE_APP_ENV=development

# Cookies: por omissao seguem o NODE_ENV.
# Poe "false" so se precisares de demonstrar uma build de producao em http.
# COOKIE_SECURE=true

# Onde ficam as imagens carregadas (por omissao ./uploads)
# UPLOAD_DIR=/app/uploads

# --- Início de sessão com a Google (opcional) -------------------------
# Sem estas duas, o SSO fica desligado e o botão não aparece na app.
#
# Onde obter: console.cloud.google.com -> APIs e Serviços -> Credenciais
# -> Criar credenciais -> ID de cliente OAuth -> Aplicação Web.
#
# Em "URIs de redirecionamento autorizados" tem de constar EXATAMENTE:
#   http://localhost:5173/api/auth/google/callback     (desenvolvimento)
#   https://o-teu-dominio/api/auth/google/callback     (produção)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
#
# Por omissão o URI de retorno é FRONTEND_URL + /api/auth/google/callback.
# Só define isto se precisares de outro:
# GOOGLE_REDIRECT_URI=

# --- Envio de email (SMTP) --------------------------------------------
# Em desenvolvimento não é preciso mexer aqui: o `docker-compose.dev.yml`
# sobe um Mailpit e aponta a app para ele (SMTP_AUTH=none, porta 1025). Tudo
# o que a app enviar fica em http://localhost:8025 e não sai da máquina —
# qualquer endereço serve para criar conta, e o link de verificação aparece
# lá em segundos.
#
# Estas variáveis são para o envio a sério (produção, ou provar o Gmail em
# casa). Sem SMTP_USER e SMTP_PASSWORD, e sem SMTP_AUTH=none, o envio fica
# desligado: a recuperação de password não é oferecida e a app continua a
# arrancar na mesma.
#
# Gmail: a password tem de ser uma *password de aplicação* de 16 letras,
# gerada em myaccount.google.com/apppasswords (exige verificação em dois
# passos ligada na conta). A password normal da conta não funciona.
#
# Outro alojamento: muda o host e a porta (587 = STARTTLS, 465 = TLS).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
#
# "login" (por omissão) usa as credenciais abaixo; "none" é para um servidor
# que não as pede — o Mailpit, ou um relay na própria máquina. Com "none" o
# MAIL_FROM passa a ser obrigatório: não há SMTP_USER de onde o tirar.
#
# Credenciais definidas ganham sempre a SMTP_AUTH=none (que é o que o compose
# de desenvolvimento põe por omissão), com um aviso no arranque: preencher o
# SMTP_USER aqui basta para o Mailpit sair da frente.
SMTP_AUTH=login
SMTP_USER=
SMTP_PASSWORD=
#
# O "De:" que aparece no email. Com autenticação, o endereço tem de ser o
# mesmo do SMTP_USER, senão o Gmail reescreve-o ou rejeita o envio.
MAIL_FROM=Chef XP <>
